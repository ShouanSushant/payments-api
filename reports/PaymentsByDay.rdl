  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>PaymentsReporting</DataSourceName>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
        <CommandText>SELECT Day, Payments, Received, Refunded, Net
   FROM dbo.vw_PaymentsByDay
   ORDER BY Day;</CommandText>
      </Query>
      <Fields>
        <Field Name="Day">
          <rd:TypeName>System.DateTime</rd:TypeName>
          <DataField>Day</DataField>
        </Field>
        <Field Name="Payments">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>Payments</DataField>
        </Field>
        <Field Name="Received">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>Received</DataField>
        </Field>
        <Field Name="Refunded">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>Refunded</DataField>
        </Field>
        <Field Name="Net">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>Net</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
